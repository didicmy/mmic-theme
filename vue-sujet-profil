html body .mmic-vt-post-anchor {
    color: #A76452 !important;
}


/* ---------------------------------------------------------
   VOTE
   --------------------------------------------------------- */

html body .mmic-vt-vote-button a {
    background: #A96F68 !important;
    color: #FFF8F4 !important;

    transition:
        background .18s ease,
        transform .18s ease !important;
}

html body .mmic-vt-vote-button a:hover {
    transform: translateY(-1px);

    background: #8F5D58 !important;
}


/* ---------------------------------------------------------
   PIÈCES JOINTES
   --------------------------------------------------------- */

html body .mmic-vt-attachments {
    border-color: #E7C2B5 !important;

    background: #FFF7F2 !important;
}

html body .mmic-vt-attachments > dt {
    color: #A76452 !important;
}


/* ---------------------------------------------------------
   BAS DU SUJET
   --------------------------------------------------------- */

html body .mmic-vt-topic-bottom {
    border-color: #E7C2B5 !important;

    background: #FFF8F4 !important;

    color: #8F7A73 !important;
}

html body .mmic-vt-watch-topic a {
    color: #75433F !important;
}


/* ---------------------------------------------------------
   RÉPONSE RAPIDE
   --------------------------------------------------------- */

html body .mmic-vt-quick-reply {
    border-color: #E7C2B5 !important;

    background: #FFFDFB !important;

    box-shadow:
        0 3px 10px rgba(117,67,63,.04) !important;
}


/* ---------------------------------------------------------
   PERMISSIONS
   --------------------------------------------------------- */

html body .mmic-vt-permissions {
    border-color: #E7C2B5 !important;

    background: #FFF8F4 !important;
}

html body .mmic-vt-permissions-title {
    border-right-color: #E7C2B5 !important;

    color: #A76452 !important;
}

html body .mmic-vt-permissions-content {
    color: #8F7A73 !important;
}


/* ---------------------------------------------------------
   OUTILS INFÉRIEURS
   --------------------------------------------------------- */

html body .mmic-vt-bottom-tools {
    border-color: #E7C2B5 !important;

    background: #FFFDFB !important;
}

html body .mmic-vt-jumpbox {
    color: #8F7A73 !important;
}

html body .mmic-vt-jumpbox select {
    border-color: #E7C2B5 !important;

    background: #FFF8F4 !important;

    color: #75433F !important;
}


/* ---------------------------------------------------------
   MODÉRATION / ADMIN
   --------------------------------------------------------- */

html body .mmic-vt-moderation-panel,
html body .mmic-vt-admin-tools {
    border-color: #E7C2B5 !important;

    background: #FFF8F4 !important;

    color: #8F7A73 !important;
}


/* ---------------------------------------------------------
   MESSAGE MASQUÉ / ABSENT
   --------------------------------------------------------- */

html body .mmic-vt-hidden-post,
html body .mmic-vt-no-post {
    border-color: #E7C2B5 !important;

    background: #FFF8F4 !important;

    color: #8F7A73 !important;
}


/* ---------------------------------------------------------
   MOBILE
   --------------------------------------------------------- */

@media (max-width: 600px) {

    html body .mmic-vt-profile {
        border-right: 0 !important;
        border-bottom: 3px solid #D58D7A !important;
    }

    html body .mmic-vt-permissions-title {
        border-right: 0 !important;
        border-bottom-color: #E7C2B5 !important;
    }

}
